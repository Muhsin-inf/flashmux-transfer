{
  "name": "local-p2p-transfer",
  "version": "1.0.0",
  "private": true,
  "description": "Local P2P File Transfer via WebRTC DataChannel & Node.js WebSocket Signaling Server",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "start:server": "npm run start --prefix server"
  },
  "keywords": [
    "p2p",
    "webrtc",
    "file-transfer",
    "react",
    "vite",
    "express",
    "ws"
  ],
